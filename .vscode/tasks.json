{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "/usr/bin/g++",
      "args": [
        "-std=gnu++17",
        "-Wall",
        "-Wextra",
        "-O2",
        "-g",
        "-fsanitize=address,undefined",
        "-I${workspaceFolder}/ac-library",
        "-I${workspaceFolder}/bits",
        "-o",
        "${workspaceFolder}/problem.exe",
        "${file}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
