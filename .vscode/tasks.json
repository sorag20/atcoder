{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "/opt/homebrew/bin/g++-15",
      "args": [
        "-std=gnu++23",
        "-Wall",
        "-Wextra",
        "-O2",
        "-g",
        "-I${workspaceFolder}/ac-library",
        "-isystem", "${workspaceFolder}/bits",
        "-Wno-cpp",
        "-o",
        "${workspaceFolder}/problem.exe",
        "${file}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
